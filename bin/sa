#!/usr/bin/env bash
# sa <new|eval|gate|ledger|loop|digest|raw|upgrade> ... — dispatcher for the sa commands.
set -euo pipefail
CORE="$(cd "$(dirname "$0")/.." && pwd)"
cmd="${1:-}"; shift || true
[[ -f "$CORE/cmd/$cmd.py" ]] || { echo "usage: sa <new|eval|gate|ledger|loop|digest|raw|upgrade> ..." >&2; exit 2; }
exec uv run --script "$CORE/cmd/$cmd.py" "$@"
